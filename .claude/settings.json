{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/project/5project/AgentBridge-master/agent-adapter/dist/hooks/approval-relay.js\"",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/project/5project/AgentBridge-master/agent-adapter/dist/hooks/summary-relay.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash", "Edit", "Write"]
  }
}
